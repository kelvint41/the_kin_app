rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{document} {
      // A business is always born at the free Community tier. Paid-status
      // fields can never be self-set at creation by a client; only the
      // entitlement-sync Cloud Function (RevenueCat webhook, Admin SDK,
      // bypasses rules) may elevate them. See PAYMENTS_BLUEPRINT.md.
      allow create: if request.auth != null
        && request.resource.data.get('is_premium', false) == false
        && request.resource.data.get('subscription_tier', 'Community') == 'Community'
        && request.resource.data.get('is_priority_pinned', false) == false
        && request.resource.data.get('is_published', false) == false;

      allow read: if true;

      // Owners may edit their own listing, but NOT the paid-status fields
      // (is_premium, subscription_tier, is_priority_pinned) — those are
      // written solely by the server entitlement sync, which closes the
      // forgeable-entitlement hole (PAYMENTS_BLUEPRINT.md, Critical Risk #1).
      // has_flash_beacon is deliberately NOT locked: it's Power Hour usage
      // state toggled by KinServices.start/stopPowerHour, and is gated by
      // the now-trusted subscription_tier server-side.
      allow update: if resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['is_premium', 'subscription_tier', 'is_priority_pinned']);

      allow delete: if resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /users/{document} {
      allow create: if request.auth.uid == document;
      allow read: if request.auth.uid == document;
      allow write: if request.auth.uid == document;
      allow delete: if request.auth.uid == document;
    }

    // Uniqueness reservation for customer Kindex ticker symbols. Doc ID is
    // the ticker itself, so a write to a free ticker is a Firestore
    // 'create' (allowed) while a write to an already-taken one is an
    // 'update' against an existing doc ('allow update: if false' blocks
    // it) - this makes reservation atomic without needing a transaction
    // or a query against the self-only `users` collection.
    match /ticker_registry/{ticker} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /bug_reports/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /analytics_events/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /claim_requests/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /marketing_requests/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /orders/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /agency_queue/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /exchange_posts/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && get(request.resource.data.business_ref).data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && get(request.resource.data.business_ref).data.is_verified == true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /activity_logs/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /analytics_daily/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /legal_metadata/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /exchange_promotions/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /connections/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /tier_privileges/{document} {
      allow create: if false;
      allow read: if request.auth.uid == resource.data.owner_id;
      allow write: if false;
      allow delete: if false;
    }

    // Entitlement records are written ONLY by the server entitlement sync
    // (Admin SDK, bypasses rules). Closing create to clients prevents a
    // client from injecting a forged entitlement doc. Read stays open for
    // now (records are unused until the Phase B webhook defines their shape;
    // owner-scoped reads land with that field structure).
    match /entitlements/{document} {
      allow create: if false;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /uservisits/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /reviews/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.business_ref is path
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /signup_feed/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
      allow write: if false;
      allow delete: if false;
    }

    match /UserEngagementEvents/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.status == 'pending'
        && !('points_awarded' in request.resource.data)
        && !('weight_version' in request.resource.data)
        && !('processed_at' in request.resource.data);
      allow read: if request.auth != null
        && resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow write: if false;
      allow delete: if false;
    }

    match /KindexScores/{document} {
      allow create: if false;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    // daily_codes/{businessId} — written solely by rotateDailyCodes /
    // getMyCheckinCode Cloud Functions (Admin SDK, bypasses rules).
    // Business owner may read their own code; customers verify via the
    // redeemCheckinCode callable, which reads server-side.
    match /daily_codes/{businessId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/businesses/$(businessId))
             .data.owner_ref
           == /databases/$(database)/documents/users/$(request.auth.uid);
      allow write: if false;
    }

    // loyalty_checkins/{userId}_{businessId}_{date} — written solely by the
    // redeemCheckinCode callable (Admin SDK transaction). Users may read
    // their own records to display loyalty history client-side.
    match /loyalty_checkins/{checkinId} {
      allow read: if request.auth != null
        && resource.data.user_ref
           == /databases/$(database)/documents/users/$(request.auth.uid);
      allow write: if false;
    }

    match /kindex_config/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    // Written only by generateMarketingContent/logAiSuggestionEngagement
    // (Cloud Functions, Admin SDK - bypasses rules entirely). No client
    // path needs to read or write this directly; entitlement, latency, and
    // engagement all round-trip through the callable functions instead.
    match /ai_generation_logs/{document} {
      allow read, write: if false;

      match /engagement/{engagementDocument} {
        allow read, write: if false;
      }
    }
  }
}
