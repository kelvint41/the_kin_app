rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fields a business OWNER is allowed to change from the client (profile
    // content + Power Hour promo state). Anything NOT in this list is
    // server-controlled and can only be written by a Cloud Function via the
    // Admin SDK (which bypasses these rules). In particular the paywall /
    // trust / rank fields are intentionally absent:
    //   subscription_tier, is_premium, is_priority_pinned  (billing/paywall)
    //   is_verified, is_claimed, claimed_by_user_id        (trust/claim)
    //   kindex_score, kindex_velocity, review_score,
    //   review_count, interaction_count, total_sentiment_score,
    //   connection_count, tier_level                       (computed rank)
    //   marketing_tier, marketing_generations_used,
    //   monthly_promo_count, monthly_promo_reset_date,
    //   scheduled_promo_date                               (server-metered)
    //   loi_signed, loi_date                               (legal)
    //   owner_ref, ticker_symbol                           (identity, set at create)
    // NOTE: the Power Hour fields below stay client-writable so the existing
    // client-side startPowerHour/stopPowerHour keep working. Their per-tier
    // caps are still only enforced client-side, so a modified client could
    // set them directly - see the follow-up note in the audit. Move them
    // server-side to fully close that.
    function mutableBusinessFields() {
      return [
        // Core profile
        'business_name', 'category', 'business_type', 'description',
        'phone_number', 'email', 'website', 'owner_name', 'established_year',
        'opening_time', 'closing_time',
        // Location
        'address', 'city', 'state', 'zip_code_postcode', 'business_location',
        'latitude', 'longitude', 'coordinates',
        // Media
        'hero_image', 'photo_gallery',
        // Attributes / flags
        'is_black_owned', 'is_veteran', 'is_ecommerce', 'is_farmer',
        'is_wholesale', 'is_retail',
        // Social links
        'instagram_url', 'facebook_url', 'tiktok_url', 'linkedin_url',
        // Delivery
        'doordash_url', 'ubereats_url', 'grubhub_url', 'is_delivery_eligible',
        // AR
        'ar_asset_url', 'arc_asset_url', 'is_ar_enabled',
        // Power Hour promo state (client-writable; see note above)
        'has_flash_beacon', 'flash_beacon_expires_at',
        'flash_beacon_duration_minutes', 'power_hour_usage_count',
        'power_hour_last_reset'
      ];
    }

    match /businesses/{document} {
      allow read: if true;
      // owner_ref must point at the creator - blocks creating businesses
      // attributed to other users (or ownerless orphans). Every legit
      // create path (KinServices.registerBusiness, the dev-bypass seeding
      // in main.dart) already sets owner_ref to the signed-in user;
      // directory imports use the Admin SDK and bypass rules.
      allow create: if request.auth != null
        && request.resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      // Owner may update ONLY the fields in mutableBusinessFields(). hasOnly
      // rejects the write if any other key changed - so subscription_tier,
      // is_verified, kindex_score, owner_ref, etc. cannot be set from the
      // client even by the business's own owner. Tier upgrades/downgrades
      // now go through a Cloud Function instead (see audit / KinServices note).
      allow update: if resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(mutableBusinessFields());
      allow delete: if resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /users/{document} {
      allow read: if request.auth.uid == document;
      allow delete: if request.auth.uid == document;
      // Client may create their own doc, but never pre-set is_admin true.
      allow create: if request.auth.uid == document
        && (!('is_admin' in request.resource.data)
            || request.resource.data.is_admin == false);
      // Client may update their own doc, but can never add, grant, or revoke
      // is_admin - that field is managed only server-side (Admin SDK, which
      // bypasses these rules). affectedKeys() rejects the write if is_admin
      // is among the changed keys, while leaving all other profile edits
      // (last_login, display_name, owned_business, ...) allowed.
      allow update: if request.auth.uid == document
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_admin']);
    }

    // Uniqueness reservation for customer Kindex ticker symbols. Doc ID is
    // the ticker itself, so a write to a free ticker is a Firestore
    // 'create' (allowed) while a write to an already-taken one is an
    // 'update' against an existing doc ('allow update: if false' blocks
    // it) - this makes reservation atomic without needing a transaction
    // or a query against the self-only `users` collection.
    match /ticker_registry/{ticker} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /bug_reports/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /analytics_events/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /claim_requests/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /marketing_requests/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /orders/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    // Internal ops/project-tracking data (assigned_editor, current_step,
    // delivery dates). Only read client-side by the app_builder_concept
    // demo pages; nothing in the client creates docs here - intake happens
    // via console/Admin SDK, which bypasses rules.
    match /agency_queue/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /exchange_posts/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && get(request.resource.data.business_ref).data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && get(request.resource.data.business_ref).data.is_verified == true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    // Client telemetry (page views, map taps). Writes happen from pages
    // that are reachable logged-out (public directory browsing), where
    // createActivityLogsRecordData strips the null user_ref - so an
    // anonymous create is allowed, but only WITHOUT a user_ref. A
    // signed-in create must stamp itself, so nobody can write logs
    // attributed to someone else. Shape-checked to keep junk writes out.
    match /activity_logs/{document} {
      allow create: if request.resource.data.event_type is string
        && request.resource.data.timestamp is timestamp
        && (
          !('user_ref' in request.resource.data)
            ? true
            : (request.auth != null
               && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid))
        );
      // Only the Executive Dashboard reads these, and it already gates
      // itself on isAdmin client-side - this makes that gate real. Works
      // because is_admin is no longer client-writable (see /users).
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
      allow write: if false;
      allow delete: if false;
    }

    // No client-side reads or writes exist for this collection - it's
    // populated (if at all) via console/Admin SDK. Admin-read only, so a
    // future dashboard can use it without another rules change.
    match /analytics_daily/{document} {
      allow create: if false;
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
      allow write: if false;
      allow delete: if false;
    }

    // Read by the Privacy Policy page, which must work logged-out (legal
    // gate comes BEFORE signup) - so read stays public. Nothing in the
    // client creates these; updates happen via console/Admin SDK.
    match /legal_metadata/{document} {
      allow create: if false;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /exchange_promotions/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /connections/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /tier_privileges/{document} {
      allow create: if false;
      allow read: if request.auth.uid == resource.data.owner_id;
      allow write: if false;
      allow delete: if false;
    }

    // Tier/comp grants (tier, source, granted_reason, expires_at). No
    // client path reads or writes this collection, and it has no owner
    // field to scope reads to - so it's fully locked. Server-side code
    // (Admin SDK) bypasses rules; re-open deliberately if a client
    // feature ever needs it.
    match /entitlements/{document} {
      allow create: if false;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    // Legacy visit tracking - no client path reads or writes it anymore.
    // Fully locked; Admin SDK bypasses if anything server-side still
    // logs visits.
    match /uservisits/{document} {
      allow create: if false;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /reviews/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.business_ref is path
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /signup_feed/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
      allow write: if false;
      allow delete: if false;
    }

    match /UserEngagementEvents/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.status == 'pending'
        && !('points_awarded' in request.resource.data)
        && !('weight_version' in request.resource.data)
        && !('processed_at' in request.resource.data);
      allow read: if request.auth != null
        && resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow write: if false;
      allow delete: if false;
    }

    match /KindexScores/{document} {
      allow create: if false;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /kindex_config/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    // Written only by generateMarketingContent/logAiSuggestionEngagement
    // (Cloud Functions, Admin SDK - bypasses rules entirely). No client
    // path needs to read or write this directly; entitlement, latency, and
    // engagement all round-trip through the callable functions instead.
    match /ai_generation_logs/{document} {
      allow read, write: if false;

      match /engagement/{engagementDocument} {
        allow read, write: if false;
      }
    }
  }
}
