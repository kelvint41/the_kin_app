rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{document} {
      allow create: if request.auth != null;
      allow read: if true;
      allow write: if resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /users/{document} {
      allow create: if request.auth.uid == document;
      allow read: if request.auth.uid == document;
      allow write: if request.auth.uid == document;
      allow delete: if request.auth.uid == document;
    }

    // Uniqueness reservation for customer Kindex ticker symbols. Doc ID is
    // the ticker itself, so a write to a free ticker is a Firestore
    // 'create' (allowed) while a write to an already-taken one is an
    // 'update' against an existing doc ('allow update: if false' blocks
    // it) - this makes reservation atomic without needing a transaction
    // or a query against the self-only `users` collection.
    match /ticker_registry/{ticker} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /bug_reports/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /analytics_events/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /claim_requests/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /marketing_requests/{document} {
      allow create: if request.auth != null;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /orders/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /agency_queue/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /exchange_posts/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && get(request.resource.data.business_ref).data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && get(request.resource.data.business_ref).data.is_verified == true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /activity_logs/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /analytics_daily/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /legal_metadata/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /exchange_promotions/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /connections/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /tier_privileges/{document} {
      allow create: if false;
      allow read: if request.auth.uid == resource.data.owner_id;
      allow write: if false;
      allow delete: if false;
    }

    match /entitlements/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /uservisits/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /reviews/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.business_ref is path
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /signup_feed/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
      allow write: if false;
      allow delete: if false;
    }

    match /UserEngagementEvents/{document} {
      allow create: if request.auth != null
        && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.status == 'pending'
        && !('points_awarded' in request.resource.data)
        && !('weight_version' in request.resource.data)
        && !('processed_at' in request.resource.data);
      allow read: if request.auth != null
        && resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow write: if false;
      allow delete: if false;
    }

    match /KindexScores/{document} {
      allow create: if false;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /kindex_config/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    // Written only by generateMarketingContent/logAiSuggestionEngagement
    // (Cloud Functions, Admin SDK - bypasses rules entirely). No client
    // path needs to read or write this directly; entitlement, latency, and
    // engagement all round-trip through the callable functions instead.
    match /ai_generation_logs/{document} {
      allow read, write: if false;

      match /engagement/{engagementDocument} {
        allow read, write: if false;
      }
    }

    // Marketing campaigns. Publicly readable so the app can show active
    // promos to everyone. A campaign is created by (and owned by) the signed-in
    // user who runs it; only that owner can edit it. Server-maintained metric
    // counters (referral_count, impression_count, ...) are written by
    // marketing_engine.js via the Admin SDK, which bypasses these rules - the
    // owner's own updates must not touch them, so they are pinned to their
    // current values on client writes.
    match /marketing_campaigns/{document} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow update: if request.auth != null
        && resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.owner_ref == resource.data.owner_ref
        && request.resource.data.referral_count == resource.data.referral_count
        && request.resource.data.qualified_referral_count == resource.data.qualified_referral_count
        && request.resource.data.reward_granted_count == resource.data.reward_granted_count
        && request.resource.data.impression_count == resource.data.impression_count
        && request.resource.data.click_count == resource.data.click_count;
      allow delete: if false;
    }

    // Referral codes. Doc id IS the code, so a create against a taken code is a
    // Firestore create-collision (blocked) - the same atomic-uniqueness trick
    // ticker_registry uses. In practice these are minted by
    // getOrCreateReferralCode (Admin SDK); the client rule below is a safe
    // fallback that still forbids claiming a code on someone else's behalf.
    match /referral_codes/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    // Referrals are created ONLY server-side by redeemReferralCode (Admin SDK)
    // so the client can never forge who referred them. The two parties may read
    // their own referral rows; nobody writes them from the client.
    match /referrals/{document} {
      allow create: if false;
      allow read: if request.auth != null
        && (resource.data.referrer_ref == /databases/$(database)/documents/users/$(request.auth.uid)
          || resource.data.referee_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow write: if false;
      allow delete: if false;
    }

    // Per-campaign, per-region daily analytics rollup. Written server-side
    // (Admin SDK) via FieldValue.increment; publicly readable for dashboards.
    // Mirrors the existing analytics_daily posture.
    match /campaign_analytics_daily/{document} {
      allow read: if true;
      allow create: if true;
      allow write: if false;
      allow delete: if false;
    }
  }
}
