# Flutter/Dart/Pub related
# .dart_tool/ holds machine-specific absolute paths (each developer's
# pub-cache and Flutter SDK location), so committing it means every
# `flutter pub get` produces a spurious diff that breaks the next
# person's analyzer until they re-run it themselves.
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# iOS/macOS ephemeral build state
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/

# Firebase Cloud Functions
firebase/custom_cloud_functions/node_modules/
firebase/functions/node_modules/
functions/node_modules/

# Firebase CLI deploy cache
.firebase/
firebase/.firebase/

# Directory source data. The BOB Bexar certified listing carries owner
# names and personal email addresses for 366 third parties, so it and
# anything derived from it stay out of the repo - see
# firebase/scripts/apply_bob_certification.js.
BOB_Bexar*.csv
firebase/scripts/bob_reverification_worklist.csv
firebase/scripts/bob_certification_results.json
firebase/scripts/bob_geocode_high_confidence.csv

# Import/cleanup run logs - machine-specific document IDs, regenerated by
# re-running the scripts in firebase/scripts/.
firebase/scripts/dedupe_results.json
firebase/scripts/import_results.json
firebase/scripts/seed_directory_test_batch_results.json
firebase/scripts/backfill_results.json
firebase/scripts/repair_results.json
firebase/scripts/delete_legacy_chains_results.json

# Pre-cleanup snapshots of the businesses collection. Full copies of live
# Firestore data - keep them locally as a restore path, out of the repo.
firebase/scripts/businesses_backup_*.json
